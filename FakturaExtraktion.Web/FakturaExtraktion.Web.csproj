<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FakturaExtraktion.Web</RootNamespace>
    <!-- Godtycklig GUID – krävs för dotnet user-secrets. Byt gärna ut den. -->
    <UserSecretsId>d3f9a6b4-2e5c-49b1-8a4f-6c1d0e8b2f77</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core delade ramverket ger redan Hosting/DI/Http/Logging/
         Options, så bara det som INTE ingår där behöver anges explicit: -->
    <!-- Retry/timeout (Polly v8) för HttpClient, samma som konsolappen -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <!-- Stöd för "eller user-secrets" som alternativ till miljövariabeln -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Återanvänder ExtraheradFaktura/Betalning/Radpost/GranskningsResultat
         och IInvoiceExtractor/IInvoiceValidator som de är – ingen ny
         extraktions-/valideringslogik skrivs i det här projektet. -->
    <ProjectReference Include="..\FakturaExtraktion.Core\FakturaExtraktion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
